{
  config,
  lib,
  pkgs,
  ...
}: {
  # =========================================================================
  # ZRAM - 基于内存的压缩交换空间
  # 通过压缩内存页来减少物理内存使用，避免频繁磁盘 I/O
  # =========================================================================

  zramSwap = {
    enable = true;

    # 压缩算法 - zstd 在压缩比和速度之间有良好平衡
    algorithm = "zstd";

    # 内存百分比 - 最多使用 100% RAM 作为压缩后的交换空间
    # 实际占用取决于压缩比（通常压缩后占 30-50% 原始大小）
    memoryPercent = 100;

    # 交换优先级 - 高于磁盘 swap，确保优先使用 zram
    # 默认值为 5，磁盘 swap 默认为 -1 到 -2
    priority = 5;
  };
}
