/**
 * Rofi configuration - ml4w style
 * Catppuccin Mocha color scheme
 */

* {
    /* Catppuccin Mocha palette */
    rosewater:  #f5e0dc;
    flamingo:   #f2cdcd;
    pink:       #f5c2e7;
    mauve:      #cba6f7;
    red:        #f38ba8;
    maroon:     #eba0ac;
    peach:      #fab387;
    yellow:     #f9e2af;
    green:      #a6e3a1;
    teal:       #94e2d5;
    sky:        #89dceb;
    sapphire:   #74c7ec;
    blue:       #89b4fa;
    lavender:   #b4befe;
    text:       #cdd6f4;
    subtext1:   #bac2de;
    subtext0:   #a6adc8;
    overlay2:   #9399b2;
    overlay1:   #7f849c;
    overlay0:   #6c7086;
    surface2:   #585b70;
    surface1:   #45475a;
    surface0:   #313244;
    base:       #1e1e2e;
    mantle:     #181825;
    crust:      #11111b;

    /* Font */
    font:       "Sarasa Mono SC 11";

    /* Spacing */
    spacing:    4;
    padding:    12px;

    /* Background */
    background-color: transparent;
}

window {
    transparency:  "real";
    background-color: @base;
    border:        2px;
    border-color:  @surface0;
    border-radius: 12px;
    padding:       @padding;
    width:         600px;
    height:        400px;
    location:      center;
    anchor:        center;
}

mainbox {
    children:   [inputbar, listview];
    spacing:    @spacing;
}

inputbar {
    children:       [entry, case-indicator];
    background-color: @surface0;
    border-radius:  8px;
    padding:        8px 12px;
    spacing:        8px;
}

case-indicator {
    enabled: false;
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder-color: @overlay0;
    placeholder:      "Search...";
    font:             "Sarasa Mono SC 10";
    padding:          4px 0;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          4px;
    scrollbar:        false;
}

element {
    background-color: transparent;
    text-color:       @text;
    border-radius:    8px;
    padding:          8px 12px;
    orientation:      horizontal;
    spacing:          10px;
    cursor:           default;
    children:         [element-icon, element-text];
}

element selected {
    background-color: @surface0;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "Sarasa Mono SC 10";
}

element-icon {
    background-color: transparent;
    size:             24px;
}

element-icon.normal {
    size: 24px;
}

/* Prompt */
prompt {
    enabled:         false;
}

/* Mode switcher */
mode-switcher {
    enabled: true;
    background-color: transparent;
}

button {
    background-color: transparent;
    text-color:       @overlay0;
    padding:          4px 8px;
    border-radius:    6px;
}

button selected {
    background-color: @surface0;
    text-color:       @mauve;
}

message {
    background-color: transparent;
    text-color:       @overlay0;
}

textbox {
    background-color: transparent;
}
