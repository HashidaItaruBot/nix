/**
 * Rofi power menu - ml4w style
 */

configuration {
    show-icons: true;
    display-drun:    "Apps";
    display-run:     "Run";
    display-window:  "Windows";
    drun-display-format: "{name}";
    window-format:   "{w} {t}";
}

* {
    /* Catppuccin Mocha palette */
    rosewater:  #f5e0dc;
    flamingo:   #f2cdcd;
    pink:       #f5c2e7;
    mauve:      #cba6f7;
    red:        #f38ba8;
    maroon:     #eba0ac;
    peach:      #fab387;
    yellow:     #f9e2af;
    green:      #a6e3a1;
    teal:       #94e2d5;
    sky:        #89dceb;
    sapphire:   #74c7ec;
    blue:       #89b4fa;
    lavender:   #b4befe;
    text:       #cdd6f4;
    subtext1:   #bac2de;
    subtext0:   #a6adc8;
    overlay2:   #9399b2;
    overlay1:   #7f849c;
    overlay0:   #6c7086;
    surface2:   #585b70;
    surface1:   #45475a;
    surface0:   #313244;
    base:       #1e1e2e;
    mantle:     #181825;
    crust:      #11111b;

    font:       "Sarasa Mono SC 11";
    background-color: transparent;
}

window {
    transparency:  "real";
    background-color: @base;
    border:        2px;
    border-color:  @surface0;
    border-radius: 12px;
    padding:       8px;
    width:         300px;
    location:      center;
    anchor:        center;
}

mainbox {
    children:   [listview];
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            6;
    spacing:          2px;
    scrollbar:        false;
    layout:           vertical;
}

element {
    background-color: @surface0;
    text-color:       @text;
    border-radius:    8px;
    padding:          6px 10px;
    orientation:      horizontal;
    spacing:          10px;
    cursor:           default;
}

element selected {
    background-color: @surface1;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "Sarasa Mono SC 11";
}

element-icon {
    background-color: transparent;
    size:             20px;
}
