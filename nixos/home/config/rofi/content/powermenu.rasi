/**
 * Rofi power menu - ML4W glass-morphism style
 * Catppuccin Mocha color scheme
 */

configuration {
    show-icons: true;
    display-drun:    "Apps";
    display-run:     "Run";
    display-window:  "Windows";
    drun-display-format: "{name}";
    window-format:   "{w}  ·  {t}";
}

* {
    /* Catppuccin Mocha palette */
    rosewater:  #f5e0dc;
    flamingo:   #f2cdcd;
    pink:       #f5c2e7;
    mauve:      #cba6f7;
    red:        #f38ba8;
    maroon:     #eba0ac;
    peach:      #fab387;
    yellow:     #f9e2af;
    green:      #a6e3a1;
    teal:       #94e2d5;
    sky:        #89dceb;
    sapphire:   #74c7ec;
    blue:       #89b4fa;
    lavender:   #b4befe;
    text:       #cdd6f4;
    subtext1:   #bac2de;
    subtext0:   #a6adc8;
    overlay2:   #9399b2;
    overlay1:   #7f849c;
    overlay0:   #6c7086;
    surface2:   #585b70;
    surface1:   #45475a;
    surface0:   #313244;
    base:       #1e1e2e;
    mantle:     #181825;
    crust:      #11111b;

    /* Glass-morphism rgba */
    glass-base:     rgba(30, 30, 46, 0.80);
    glass-surface:  rgba(49, 50, 68, 0.60);
    glass-hover:    rgba(69, 71, 90, 0.70);

    font:       "Sarasa Mono SC 11";
    background-color: transparent;
}

window {
    transparency:     "real";
    background-color: transparent;
    border:           0px;
    border-radius:    20px;
    padding:          0.8em;
    width:            18em;
    location:         center;
    anchor:           center;
    cursor:           "default";
}

mainbox {
    children:   [listview];
    background-color: @glass-base;
    border-radius: 1.2em;
    padding:    0.5em;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            6;
    spacing:          0.3em;
    scrollbar:        false;
    layout:           vertical;
}

element {
    background-color: @glass-surface;
    text-color:       @text;
    border-radius:    1em;
    padding:          0.7em 1.2em;
    orientation:      horizontal;
    spacing:          0.8em;
    cursor:           pointer;
}

element selected {
    background-color: @mauve;
    text-color:       @base;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "Sarasa Mono SC 11";
}

element-icon {
    background-color: transparent;
    size:             22px;
}

case-indicator {
    enabled: false;
}

prompt {
    enabled: false;
}

textbox {
    background-color: transparent;
}
