/**
 * Rofi application launcher - ML4W dual-column style
 * Catppuccin Mocha color scheme + glass-morphism
 */

configuration {
    show-icons: true;
    display-drun:    "  Apps";
    display-run:     "  Run";
    display-window:  "  Windows";
    display-filebrowser: "  Files";
    drun-display-format: "{name}";
    window-format:   "{w}  ·  {t}";
}

* {
    /* Catppuccin Mocha palette */
    rosewater:  #f5e0dc;
    flamingo:   #f2cdcd;
    pink:       #f5c2e7;
    mauve:      #cba6f7;
    red:        #f38ba8;
    maroon:     #eba0ac;
    peach:      #fab387;
    yellow:     #f9e2af;
    green:      #a6e3a1;
    teal:       #94e2d5;
    sky:        #89dceb;
    sapphire:   #74c7ec;
    blue:       #89b4fa;
    lavender:   #b4befe;
    text:       #cdd6f4;
    subtext1:   #bac2de;
    subtext0:   #a6adc8;
    overlay2:   #9399b2;
    overlay1:   #7f849c;
    overlay0:   #6c7086;
    surface2:   #585b70;
    surface1:   #45475a;
    surface0:   #313244;
    base:       #1e1e2e;
    mantle:     #181825;
    crust:      #11111b;

    /* Glass-morphism rgba overlays */
    glass-base:     rgba(30, 30, 46, 0.75);
    glass-surface:  rgba(49, 50, 68, 0.55);
    glass-hover:    rgba(69, 71, 90, 0.65);
    glass-selected: rgba(203, 166, 247, 0.30);

    font:       "Sarasa Mono SC 11";
    background-color: transparent;
}

window {
    transparency:     "real";
    background-color: transparent;
    border:           0px;
    border-radius:    24px;
    padding:          0.6em;
    width:            50em;
    height:           32em;
    location:         center;
    anchor:           center;
    cursor:           "default";
}

mainbox {
    children:   [imagebox, listbox];
    orientation: horizontal;
    spacing:    0.6em;
    background-color: transparent;
}

/* ── Left panel: search + mode switcher ── */
imagebox {
    children:   [inputbar, modi];
    orientation: vertical;
    spacing:    0.6em;
    padding:    0.5em;
    background-color: @glass-base;
    border-radius: 1.2em;
}

inputbar {
    children:   [textbox-prompt-colon, entry];
    background-color: @glass-surface;
    border-radius: 0.8em 0.8em 0em 0em;
    padding:    0.8em 1em;
    spacing:    0.5em;
}

textbox-prompt-colon {
    enabled:    false;
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder-color: @overlay0;
    placeholder:      "Search";
    font:             "Sarasa Mono SC 11";
    padding:          0;
}

modi {
    children:   [button-run, button-drun, button-window, button-filebrowser];
    orientation: vertical;
    spacing:    0.4em;
    padding:    0.4em 0;
}

button {
    background-color: @glass-surface;
    text-color:       @overlay0;
    border-radius:    1.5em;
    padding:          0.7em 1.2em;
    cursor:           pointer;
    font:             "Sarasa Mono SC 10";
}

button selected {
    background-color: @mauve;
    text-color:       @base;
}

/* ── Right panel: application list ── */
listbox {
    children:   [listview];
    orientation: vertical;
    spacing:    0;
    padding:    0.5em;
    background-color: @glass-base;
    border-radius: 1.2em;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            10;
    spacing:          0.2em;
    scrollbar:        false;
    layout:           vertical;
}

element {
    background-color: transparent;
    text-color:       @text;
    border-radius:    1em;
    padding:          0.5em 1em;
    orientation:      horizontal;
    spacing:          0.8em;
    cursor:           pointer;
}

element selected {
    background-color: @glass-selected;
}

element normal {
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "Sarasa Mono SC 11";
}

element-icon {
    background-color: transparent;
    size:             26px;
}

/* Hide unused widgets */
case-indicator {
    enabled: false;
}

prompt {
    enabled: false;
}

message {
    background-color: transparent;
    text-color:       @overlay0;
}

textbox {
    background-color: transparent;
}
