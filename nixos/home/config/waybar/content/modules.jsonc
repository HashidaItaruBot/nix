{
    // ============================================================
    //  HYPRLAND WORKSPACES
    // ============================================================
    "hyprland/workspaces": {
        "on-scroll-down": "hyprctl dispatch workspace e+1",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format": "{}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    // ============================================================
    //  HYPRLAND WINDOW
    // ============================================================
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true,
        "rewrite": {
            "(.*) - Brave": "$1",
            "(.*) - Chromium": "$1",
            "(.*) - Brave Search": "$1"
        }
    },

    // ============================================================
    //  APP MENU
    // ============================================================
    "custom/appmenu": {
        "format": "Apps",
        "on-click": "~/.config/rofi/launcher.sh",
        "on-click-right": "~/.config/hypr/scripts/keybindings.sh",
        "tooltip-format": "Left: Open the application launcher\nRight: Show all keybindings"
    },

    // ============================================================
    //  SYSTEM TRAY
    // ============================================================
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },

    // ============================================================
    //  PULSEAUDIO (PipeWire)
    // ============================================================
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },

    // ============================================================
    //  BLUETOOTH
    // ============================================================
    "bluetooth": {
        "format": " {status}",
        "format-disabled": "",
        "format-off": "",
        "interval": 30,
        "on-click": "sleep 0.1 && bluetoothctl power toggle",
        "on-click-right": "blueman-applet",
        "tooltip-format-connected": "Connected devices: {num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} | Battery life: {device_battery_percentage}%",
        "format-no-controller": ""
    },

    // ============================================================
    //  NETWORK
    // ============================================================
    "network": {
        "format": "{ifname}",
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": "Disconnected ",
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "ghostty -e nmtui"
    },

    // ============================================================
    //  BATTERY
    // ============================================================
    "battery": {
        "interval": 1,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },

    // ============================================================
    //  CLOCK
    // ============================================================
    "clock": {
        "format": "{:%H:%M %a}",
        "tooltip": false
    },

    // ============================================================
    //  NOTIFICATION
    // ============================================================
    "custom/notification": {
        "tooltip-format": "Left: Notifications\nRight: Do not disturb",
        "format": "{icon}",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none": "",
            "inhibited-notification": "",
            "inhibited-none": "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/notification-status.sh",
        "exec-if": "which dunstctl",
        "on-click": "dunstctl set-paused toggle",
        "on-click-right": "dunstctl close-all",
        "escape": true,
        "interval": 10
    },

    // ============================================================
    //  UPDATES
    // ============================================================
    "custom/updates": {
        "format": " {}",
        "escape": true,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/check-updates.sh",
        "interval": 1800,
        "signal": 1,
        "hide-empty-text": true,
        "on-click": "ghostty -e nix-shell -p nh --run 'nh os switch'",
        "on-click-right": "ghostty -e nixos-rebuild dry-build"
    },

    // ============================================================
    //  EXIT / POWER MENU
    // ============================================================
    "custom/exit": {
        "format": "",
        "on-click": "wlogout",
        "on-click-right": "hyprctl dispatch exit",
        "tooltip-format": "Open Power Menu"
    },

    // ============================================================
    //  GROUP: HARDWARE
    // ============================================================
    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/system",
            "disk",
            "cpu",
            "memory",
            "hyprland/language"
        ]
    },

    "custom/system": {
        "format": "",
        "tooltip-format": "System Info",
        "on-click": "ghostty -e htop"
    },

    "cpu": {
        "format": "/ C {usage}% ",
        "on-click": "ghostty -e htop"
    },

    "memory": {
        "format": "/ M {}% ",
        "on-click": "ghostty -e htop"
    },

    "disk": {
        "interval": 30,
        "format": "D {percentage_used}% ",
        "path": "/",
        "on-click": "ghostty -e htop"
    },

    "hyprland/language": {
        "format": "/ K {short}",
        "on-click": "hyprctl switchxkblayout all next"
    },

    // ============================================================
    //  GROUP: TOOLS
    // ============================================================
    "group/tools": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/tools",
            "custom/colorpicker",
            "custom/screenshot",
            "custom/clipboard"
        ]
    },

    "custom/tools": {
        "format": "",
        "tooltip-format": "Tools"
    },

    "custom/colorpicker": {
        "format": "",
        "on-click": "hyprpicker -a",
        "tooltip-format": "Color Picker"
    },

    "custom/screenshot": {
        "format": "",
        "on-click": "grim -g \"$(slurp)\" - | wl-copy && wl-paste > ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png",
        "on-click-right": "grim - | wl-copy && wl-paste > ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png",
        "tooltip-format": "Screenshot (area/full)"
    },

    "custom/clipboard": {
        "format": "",
        "on-click": "sleep 0.1 && cliphist list | rofi -dmenu -p 'Clipboard' | cliphist decode | wl-copy",
        "on-click-right": "sleep 0.1 && cliphist wipe",
        "tooltip-format": "Left: Open clipboard Manager\nRight: Clear list"
    }
}
