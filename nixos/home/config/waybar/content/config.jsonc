{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "include": [
        "~/.config/waybar/modules.jsonc"
    ],

    // ===== LEFT =====
    "modules-left": [
        "custom/appmenu",
        "hyprland/workspaces"
    ],

    // ===== CENTER =====
    "modules-center": [
        "hyprland/window"
    ],

    // ===== RIGHT =====
    "modules-right": [
        "custom/updates",
        "group/hardware",
        "pulseaudio",
        "bluetooth",
        "network",
        "battery",
        "group/tools",
        "tray",
        "custom/notification",
        "custom/exit",
        "clock"
    ]
}
