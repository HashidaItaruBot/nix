# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ self, config, lib, pkgs, modulesPath, inputs, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
      inputs.lanzaboote.nixosModules.lanzaboote
      inputs.sops-nix.nixosModules.sops
    ];

  
  boot.initrd.systemd.enable = true;
  boot.initrd.availableKernelModules = [ "nvme" "xhci_pci" "usbhid" "usb_storage" "sd_mod" ];
  boot.initrd.kernelModules = [ "tpm_tis" ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];
  boot.loader.systemd-boot.enable = lib.mkForce false;
  boot.loader.efi.canTouchEfiVariables = true; # Use the systemd-boot EFI boot loader.
  boot.lanzaboote.enable = true;
  boot.lanzaboote.pkiBundle = "/etc/secureboot";
  boot.kernelPackages = pkgs.linuxPackages_xanmod_latest; # 使用 xanmod 内核

  # 解密 Secure Boot 密钥
  sops.defaultSopsFile = "${self}/shared/secrets.yaml";
  sops.age.sshKeyPaths = [ "/root/.ssh/id_ed25519" ];
  sops.secrets = {
    sb_pk_key = { owner = "root"; mode = "0400"; };
    sb_kek_key = { owner = "root"; mode = "0400"; };
    sb_db_key = { owner = "root"; mode = "0400"; };
  };

  # 组装lanzaboote的pkiBundle
  environment.etc = {
    # 映射私钥 (指向 sops 解密后的内存路径)
    "secureboot/keys/PK/PK.key".source = config.sops.secrets.sb_pk_key.path;
    "secureboot/keys/KEK/KEK.key".source = config.sops.secrets.sb_kek_key.path;
    "secureboot/keys/db/db.key".source = config.sops.secrets.sb_db_key.path;

    # 映射公钥/证书 (指向当前目录下的 keys 文件夹)
    "secureboot/keys/PK/PK.pem".source = ./secureboot/keys/PK/PK.pem;
    "secureboot/keys/KEK/KEK.pem".source = ./secureboot/keys/KEK/KEK.pem;
    "secureboot/keys/db/db.pem".source = ./secureboot/keys/db/db.pem;
    "secureboot/GUID".source = ./secureboot/GUID;
  };

  fileSystems."/" =
    { device = "/dev/disk/by-label/NIXOS";
      fsType = "btrfs";
      options = [ "subvol=@" "compress=zstd" ];
    };

  boot.initrd.luks.devices = {
    "crypt1" = {
      device = "/dev/disk/by-uuid/075c53b2-44d1-4fab-b6f2-f2af285e8111";
      crypttabExtraOpts = [ "tpm2-device=auto" ];
      preLVM = true;
    };
    "crypt2" = {
      device = "/dev/disk/by-uuid/36410584-09b5-444d-8731-e66a77b7a94a";
      crypttabExtraOpts = [ "tpm2-device=auto" ];
      preLVM = true;
    };
  };


  fileSystems."/home" =
    { device = "/dev/disk/by-label/NIXOS";
      fsType = "btrfs";
      options = [ "subvol=@home" "compress=zstd" ];
    };

  fileSystems."/nix" =
    { device = "/dev/disk/by-label/NIXOS";
      fsType = "btrfs";
      options = [ "subvol=@nix" "compress=zstd" ];
    };

  fileSystems."/var/log" =
    { device = "/dev/disk/by-label/NIXOS";
      fsType = "btrfs";
      options = [ "subvol=@log" "compress=zstd" ];
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/E9CD-7770";
      fsType = "vfat";
      options = [ "fmask=0022" "dmask=0022" ];
    };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
