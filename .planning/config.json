{
  "mode": "yolo",
  "granularity": "coarse",
  "parallelization": true,
  "commit_docs": true,
  "model_profile": "balanced",
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": true,
    "_auto_chain_active": false
  },
  "verification": {
    "commands": [
      {
        "name": "nix-format",
        "command": "nix fmt -- --check .",
        "description": "Check Nix formatting with nix fmt",
        "on_failure": "warning"
      },
      {
        "name": "statix-lint",
        "command": "statix check .",
        "description": "Run statix linter for Nix code",
        "on_failure": "warning"
      },
      {
        "name": "nix-build",
        "command": "nix flake check --no-build",
        "description": "Verify Nix flake checks",
        "on_failure": "blocker"
      }
    ]
  },
  "branching_strategy": "none"
}